{
  "llm_backends": {
    "lmstudio": {
      "type": "openai",
      "base_url": "http://localhost:1234/v1",
      "api_key": "lm-studio-placeholder",
      "model": "Qwen2.5-Coder-7B-Instruct"
    },
    "ollama": {
      "type": "openai",
      "base_url": "http://localhost:11434/v1",
      "api_key": "ollama",
      "model": "qwen2.5-coder:7b"
    },
    "openai": {
      "type": "openai",
      "base_url": "https://api.openai.com/v1",
      "api_key": "YOUR_API_KEY",
      "model": "gpt-4o"
    }
  },
  "active_backend": "lmstudio",
  "agents": {
    "planner":     { "backend": "lmstudio", "temperature": 0.2 },
    "implementer": { "backend": "lmstudio", "temperature": 0.1 },
    "reviewer":    { "backend": "lmstudio", "temperature": 0.0 },
    "validator":   { "backend": "lmstudio", "temperature": 0.0 },
    "merger":      { "backend": "lmstudio", "temperature": 0.0 }
  },
  "parallel_agents": 50,
  "parallel_engines": 50,
  "parallel_cores": 50,
  "hitl_policy": "policies/guardrails.yaml",
  "state_db": "ord_ai_state.db",
  "loop": "infinite"
}
